# Max messages to store per user session
MAX_CONTEXT_MESSAGES=20

# Session expiry in hours
SESSION_TTL_HOURS=24

# Message debounce delay in milliseconds
CHAT_BUDDY_RESPONSE_DEBOUNCE_MS=2200

# Remove inactive pending replies after this many hours
CHAT_BUDDY_PENDING_REPLY_TTL_HOURS=1

# How often to run pending reply cleanup in milliseconds
CHAT_BUDDY_PENDING_REPLY_CLEANUP_INTERVAL_MS=300000